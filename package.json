{
  "name": "boardform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Build, train and battle your own WebAssembly chess engines in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "node scripts/engine-test.mjs",
    "test:e2e": "playwright test",
    "test:scratch": "node scripts/scratch-test.mjs",
    "test:nnue": "node scripts/nnue-test.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:engine && npm run test:scratch && npm run test:nnue"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "assemblyscript": "0.28.20",
    "blockly": "13.4.0",
    "chess.js": "1.4.0",
    "idb": "8.0.4",
    "marked": "^18.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
